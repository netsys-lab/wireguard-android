<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <!-- Node marker -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/arn_node_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/scitra_path_node_bg" />

        <View
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:background="@drawable/scitra_path_line"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Node content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:background="@drawable/scitra_card_bg"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/arn_isa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/scitra_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1-ff00:0:110" />

            <TextView
                android:id="@+id/arn_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/scitra_on_primary"
                android:background="@drawable/scitra_status_badge_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                tools:text="Local AS" />
        </LinearLayout>

        <TextView
            android:id="@+id/arn_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/scitra_on_surface_variant"
            android:textSize="11sp"
            tools:text="egress interface 12 · 1 internal hop" />
    </LinearLayout>
</LinearLayout>