<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCION Paths Snapshot"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/container_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keine SCION-Pfade verfügbar."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Content Container -->
        <LinearLayout
            android:id="@+id/container_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Global Strategy -->
            <TextView
                android:id="@+id/tv_strategy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Global Selection Strategie: N/A"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp" />

            <!-- Last Refresh -->
            <TextView
                android:id="@+id/tv_last_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Refresh: N/A"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="12dp" />

            <!-- IA Pair Label & Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA - Paare:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_ia_pairs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />

            <!-- Available Paths Count -->
            <TextView
                android:id="@+id/tv_available_paths"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Paths: 0"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <!-- Path Selection Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Path:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_paths"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp" />

            <!-- Path Detail Card -->
            <LinearLayout
                android:id="@+id/card_path_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tv_fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fingerprint: -"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_next_hop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Hop: -"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry: -"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_mtu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MTU: -"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_hops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hops:\n  -"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
