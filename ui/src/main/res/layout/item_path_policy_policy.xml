<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_card_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Policy Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_policy_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Policy Definition"
            android:textColor="@color/scitra_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_delete_policy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/md_theme_dark_error"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Policy Name -->
    <EditText
        android:id="@+id/et_policy_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Policy Name (e.g. p1)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Extends -->
        <EditText
            android:id="@+id/et_policy_extends"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:hint="Extends Policy"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="12dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="13sp" />

        <!-- Failover -->
        <EditText
            android:id="@+id/et_policy_failover"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Failover Policy"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="12dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ACL Rules -->
    <EditText
        android:id="@+id/et_policy_acl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="ACL Rules (comma-separated, e.g. - 666, +)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Sequence Regexp -->
    <EditText
        android:id="@+id/et_policy_sequence"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Hop Predicate Sequence (e.g. 1-64512#20 0*)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Requirements Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/et_policy_min_mtu"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:hint="Min MTU"
            android:inputType="number"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="8dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_policy_max_latency"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:hint="Max Latency (ms)"
            android:inputType="number"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="8dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_policy_min_bandwidth"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Min Bandwidth"
            android:inputType="number"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="8dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Ordering Sorts -->
    <EditText
        android:id="@+id/et_policy_ordering"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Ordering (comma-separated, e.g. random, hops_asc)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp" />

</LinearLayout>
