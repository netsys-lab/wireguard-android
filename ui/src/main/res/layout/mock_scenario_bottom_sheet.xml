<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_bottom_sheet_bg"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backend Traffic Mode"
        android:textColor="@color/scitra_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Switch between live network traffic and simulated mock scenarios."
        android:textColor="@color/scitra_on_surface_variant"
        android:textSize="13sp" />

    <!-- Mode Toggle (Live vs Mock) -->
    <RadioGroup
        android:id="@+id/mode_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radio_live_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Backend (Real Network)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="14sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/radio_mock_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mock Backend (Simulated Data)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="14sp"
            android:paddingVertical="8dp" />
    </RadioGroup>

    <!-- Scenarios Section Header -->
    <TextView
        android:id="@+id/scenarios_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mock Scenarios"
        android:textColor="@color/scitra_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Scenario Radio Group -->
    <RadioGroup
        android:id="@+id/scenario_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/scenario_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard Multi-Path\n(Diverse candidates: Lowest Latency, Highest Bandwidth, Shortest Path)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_globe_showcase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Globe 3D Showcase\n(Intercontinental coordinates across Europe, US, and Asia for 3D Globe)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_policy_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Policy Fallback Mode\n(Simulates policy constraint failure and fallback rule activation)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending Path Discovery\n(Simulates path lookup latency with loading state and automatic retry)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_stale_override"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stale Override\n(Active path override marked as stale/expired to test recovery)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_multi_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multiple Concurrent Flows\n(Multiple active SCION flows to test flow list and detail switching)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_high_latency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High Latency / Congestion\n(Degraded paths with 300ms+ latency and high jitter)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/scenario_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empty Flows\n(Zero active flows to test empty list state)"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:paddingVertical="6dp" />
    </RadioGroup>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/scitra_on_surface_variant" />

        <Button
            android:id="@+id/btn_apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Apply" />
    </LinearLayout>

</LinearLayout>
