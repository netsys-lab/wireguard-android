<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/scitra_background">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/scitra_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/path_details_title"
            android:textColor="@color/scitra_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <!-- Badges row -->
            <LinearLayout
                android:id="@+id/pd_badge_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- Full AS route -->
            <TextView
                android:id="@+id/pd_full_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/scitra_on_surface"
android:textSize="19sp"
            android:textStyle="bold"
                tools:text="1-ff00:0:110 → 1-ff00:0:120 → 1-ff00:0:111" />

            <!-- Selection source -->
            <TextView
                android:id="@+id/pd_selection_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/scitra_on_surface_variant"
                android:textSize="12sp"
                tools:text="Selected automatically by the “Lowest Latency” policy" />

            <!-- ═══ Path Summary ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/path_information"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/scitra_section_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/advertised_latency"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/pd_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/latest_handshake"
                        android:visibility="gone" />
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/scitra_section_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottleneck_bandwidth"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/pd_bandwidth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="10" />

                    <TextView
                        android:id="@+id/pd_bandwidth_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp"
                        tools:text="Gbit/s" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/scitra_section_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inter_as_links"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/pd_links"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </LinearLayout>

                <View android:layout_width="8dp" android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/scitra_section_card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/path_mtu"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/pd_mtu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="1472" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ AS Route ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/as_route"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/pd_as_route_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- ═══ Geographic Route ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/geographic_route"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/pd_geo_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    tools:text="Zurich → Frankfurt → London" />
            </LinearLayout>

            <!-- ═══ Fingerprint ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/full_path_fingerprint"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/pd_fingerprint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="10sp"
                    android:typeface="monospace"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:text="7f9a2c4e1b8d5f3a0e6c9b4d2a1f8e5d" />

                <ImageView
                    android:id="@+id/btn_copy_fingerprint"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_action_copy"
                    android:tint="@color/scitra_primary_container"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copy_fingerprint" />
            </LinearLayout>

            <!-- ═══ Hop-by-hop Details ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/hop_by_hop"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/pd_hop_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>