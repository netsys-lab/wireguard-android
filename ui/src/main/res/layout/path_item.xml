<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_flow_item_bg"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/path_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/scitra_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/path_current_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_path_label"
            android:textColor="@color/scitra_on_primary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/scitra_status_badge_bg"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/path_latency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/scitra_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/path_metadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/scitra_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/path_next_hop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/scitra_on_surface_variant"
        android:textSize="11sp"
        android:alpha="0.7" />
</LinearLayout>
