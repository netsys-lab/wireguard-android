<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/scitra_background"
    android:fitsSystemWindows="true">

    <!-- ===== TOP APP BAR ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_close_editor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/scitra_on_surface"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close editor" />

        <TextView
            android:id="@+id/tv_header_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="PATH POLICY EDITOR"
            android:textColor="@color/scitra_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </RelativeLayout>

    <!-- ===== SCROLLABLE FORM ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tv_policy_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Policy Configuration"
                android:textColor="@color/scitra_on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_policy_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Define path filtering rules, constraints, inheritance, and sorting priorities."
                android:textColor="@color/scitra_on_surface_variant"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- ============================================== -->
            <!-- 1. IDENTITY & INHERITANCE CARD -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Identity &amp; Inheritance"
                android:textColor="@color/scitra_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Policy Name Label + Default Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Policy Name"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_default_policy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEFAULT FALLBACK"
                        android:textColor="@color/scitra_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/scitra_badge_chip_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_policy_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. p1, low_latency, video_stream"
                    android:background="@drawable/scitra_dashed_item_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textColorHint="@color/scitra_on_surface_variant"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="16dp" />

                <!-- Extends Combobox/Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extends Policy (Inheritance)"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inherits ACL, requirements, sequence, and ordering from a preceding policy."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_policy_extends"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/scitra_select_field_bg"
                    android:popupBackground="@drawable/scitra_dropdown_popup_bg"
                    android:popupElevation="12dp"
                    android:dropDownVerticalOffset="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Failover Combobox/Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failover Policy (Fallback)"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applied if this policy produces an empty set of candidate paths."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_policy_failover"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/scitra_select_field_bg"
                    android:popupBackground="@drawable/scitra_dropdown_popup_bg"
                    android:popupElevation="12dp"
                    android:dropDownVerticalOffset="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Dynamic Path Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dynamic Path Selector"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specifies live path selection logic (e.g. lowest round-trip time)."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinner_policy_selector"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/scitra_select_field_bg"
                    android:popupBackground="@drawable/scitra_dropdown_popup_bg"
                    android:popupElevation="12dp"
                    android:dropDownVerticalOffset="4dp" />

            </LinearLayout>

            <!-- ============================================== -->
            <!-- 2. REQUIREMENTS CARD -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ Physical Requirements"
                android:textColor="@color/scitra_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Min MTU -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIN MTU (BYTES)"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_min_mtu"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 1420"
                    android:inputType="number"
                    android:background="@drawable/scitra_dashed_item_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textColorHint="@color/scitra_on_surface_variant"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- Max Latency -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAX LATENCY (MS)"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_max_latency"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 50"
                    android:inputType="number"
                    android:background="@drawable/scitra_dashed_item_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textColorHint="@color/scitra_on_surface_variant"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- Min Bandwidth -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIN BANDWIDTH (KBIT/S)"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/et_min_bandwidth"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 100000"
                    android:inputType="number"
                    android:background="@drawable/scitra_dashed_item_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textColorHint="@color/scitra_on_surface_variant"
                    android:textSize="14sp"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- ============================================== -->
            <!-- 3. ACL & SEQUENCE CARD -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡 Hop Filtering &amp; Sequence"
                android:textColor="@color/scitra_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- ACL Rules -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access Control List (ACL)"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precede hop predicates with (+) to allow or (-) to block transit."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/layout_acl_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_acl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/scitra_btn_outline_bg"
                    android:text="+ Add ACL Rule"
                    android:textAllCaps="false"
                    android:textColor="@color/scitra_primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Sequence Regex -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hop Sequence (Regex)"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Regular expression of hop predicates that candidate paths must match."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_sequence"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. 1-64512#20 0*"
                    android:background="@drawable/scitra_dashed_item_bg"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textColorHint="@color/scitra_on_surface_variant"
                    android:textSize="14sp"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- ============================================== -->
            <!-- 4. PATH ORDERING (REORDERABLE!) CARD -->
            <!-- ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⇅ Path Ordering (Priority Cascade)"
                android:textColor="@color/scitra_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paths are sorted sequentially (#1 is evaluated first) with a stable sort. Use ▲ / ▼ to reorder criteria priority."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tv_ordering_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No sort order defined. Paths will appear in daemon default order."
                    android:textColor="@color/scitra_outline"
                    android:textSize="12sp"
                    android:paddingVertical="16dp"
                    android:visibility="gone" />

                <!-- Ordering List Container -->
                <LinearLayout
                    android:id="@+id/layout_ordering_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_ordering"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/scitra_btn_outline_bg"
                    android:text="+ Add Sorting Criterion"
                    android:textAllCaps="false"
                    android:textColor="@color/scitra_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM ACTION BAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/scitra_surface_container_high"
        android:elevation="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/scitra_on_surface"
            android:background="@drawable/scitra_btn_outline_bg"
            android:layout_marginEnd="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_policy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save Policy"
            android:textAllCaps="false"
            android:textColor="@color/scitra_on_primary"
            android:background="@drawable/scitra_btn_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
