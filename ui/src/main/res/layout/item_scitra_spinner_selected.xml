<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="36dp">

    <ImageView
        android:id="@+id/iv_selected_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:tint="@color/scitra_primary"
        android:src="@drawable/ic_policy_shield"
        android:contentDescription="Policy Icon" />

    <TextView
        android:id="@+id/tv_selected_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/scitra_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="secure_bank" />

    <TextView
        android:id="@+id/tv_selected_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active"
        android:textColor="@color/scitra_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/scitra_badge_chip_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginStart="6dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
