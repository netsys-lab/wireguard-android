<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/scitra_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Allow/Deny indicator -->
    <TextView
        android:id="@+id/tv_acl_type"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="+"
        android:textColor="@color/scitra_success"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/scitra_chip_unselected" />

    <!-- ACL value -->
    <EditText
        android:id="@+id/et_acl_value"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:hint="Hop predicate (e.g. 666)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:singleLine="true" />

    <!-- Delete button -->
    <ImageView
        android:id="@+id/btn_delete_acl"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/md_theme_dark_error"
        android:scaleType="centerInside"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Delete ACL entry" />

</LinearLayout>
