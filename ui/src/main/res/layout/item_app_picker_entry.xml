<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/scitra_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_app_picker_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/sym_def_app_icon"
        android:scaleType="fitCenter"
        android:contentDescription="App icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tv_app_picker_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chrome"
            android:textColor="@color/scitra_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_app_picker_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.android.chrome"
            android:textColor="@color/scitra_outline"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
