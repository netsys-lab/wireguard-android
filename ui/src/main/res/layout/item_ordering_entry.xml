<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/scitra_card_bg"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Ordering label -->
    <TextView
        android:id="@+id/tv_ordering_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Latency"
        android:textColor="@color/scitra_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Asc chip -->
    <TextView
        android:id="@+id/chip_asc"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:text="Asc"
        android:textColor="@color/scitra_on_surface"
        android:textSize="12sp"
        android:background="@drawable/scitra_chip_unselected"
        android:layout_marginEnd="6dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Desc chip -->
    <TextView
        android:id="@+id/chip_desc"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:text="Desc"
        android:textColor="@color/scitra_on_surface"
        android:textSize="12sp"
        android:background="@drawable/scitra_chip_unselected"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
