<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_card_bg"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Matcher Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_matcher_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matcher"
            android:textColor="@color/scitra_primary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_delete_matcher"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/md_theme_dark_error"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Source -->
    <EditText
        android:id="@+id/et_matcher_source"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Source Address (e.g. 1-64512)"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Destination -->
    <EditText
        android:id="@+id/et_matcher_destination"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Destination Address"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Protocol -->
        <EditText
            android:id="@+id/et_matcher_protocol"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:hint="Protocol (udp/tcp)"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="12dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="13sp" />

        <!-- Traffic Class -->
        <EditText
            android:id="@+id/et_matcher_traffic_class"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Traffic Class (DSCP)"
            android:inputType="number"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="12dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Target Policy -->
    <EditText
        android:id="@+id/et_matcher_policy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Apply Policy Name"
        android:background="@drawable/scitra_dashed_item_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/scitra_on_surface"
        android:textColorHint="@color/scitra_on_surface_variant"
        android:textSize="13sp" />

</LinearLayout>
