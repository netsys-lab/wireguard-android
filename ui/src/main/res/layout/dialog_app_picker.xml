<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/scitra_background"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_close_picker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/scitra_on_surface"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close app picker" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="SELECT APPLICATION"
            android:textColor="@color/scitra_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </RelativeLayout>

    <!-- Search Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/et_picker_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="🔍  Search apps by name or package…"
            android:background="@drawable/scitra_dashed_item_bg"
            android:paddingHorizontal="14dp"
            android:textColor="@color/scitra_on_surface"
            android:textColorHint="@color/scitra_on_surface_variant"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp">

        <ProgressBar
            android:id="@+id/pb_picker_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tv_picker_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No matching applications found."
            android:textColor="@color/scitra_outline"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_picker_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </FrameLayout>

</LinearLayout>
