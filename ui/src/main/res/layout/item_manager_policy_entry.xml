<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_card_bg"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginBottom="8dp">

    <!-- Top Row: Name, Edit/Duplicate/Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Policy Name -->
        <TextView
            android:id="@+id/tv_policy_entry_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="p1"
            android:textColor="@color/scitra_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Duplicate -->
        <ImageButton
            android:id="@+id/btn_policy_duplicate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_copy"
            app:tint="@color/scitra_on_surface_variant"
            android:contentDescription="Duplicate policy"
            android:padding="4dp"
            android:scaleType="centerInside" />

        <!-- Edit -->
        <ImageButton
            android:id="@+id/btn_policy_edit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_edit"
            app:tint="@color/scitra_primary"
            android:contentDescription="Edit policy"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp" />

        <!-- Delete -->
        <ImageButton
            android:id="@+id/btn_policy_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_action_delete"
            app:tint="@color/md_theme_dark_error"
            android:contentDescription="Delete policy"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
