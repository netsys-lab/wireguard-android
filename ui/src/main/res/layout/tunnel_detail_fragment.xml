<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.wireguard.android.backend.Tunnel.State" />

        <import type="com.wireguard.android.util.ClipboardUtils" />

        <import type="android.view.View" />

        <variable
            name="fragment"
            type="com.wireguard.android.fragment.TunnelDetailFragment" />

        <variable
            name="tunnel"
            type="com.wireguard.android.model.ObservableTunnel" />

        <variable
            name="config"
            type="com.wireguard.config.Config" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scitra_background"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- TOP BAR: Back arrow + Tunnel Name + Settings Gear -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="16dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/scitra_primary"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:onClick="@{fragment::onBackPressed}" />

                <TextView
                    android:id="@+id/tunnel_name_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{tunnel.name}"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Zurich-ETH-01" />

                <ImageView
                    android:id="@+id/btn_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/scitra_on_surface_variant"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:onClick="@{fragment::onEditTunnel}" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- STATUS ROW: SCION badge + Tunnel Status + Toggle -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp">

                <!-- SCION CONNECTION badge (only for SCION tunnels) -->
                <TextView
                    android:id="@+id/scion_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/scitra_status_badge_bg"
                    android:text="@string/scion_connection"
                    android:textColor="@color/status_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:visibility="@{config != null &amp;&amp; !config.interface.bootstrapUrl.isEmpty() ? View.VISIBLE : View.GONE}" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tunnel_status_label"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:layout_marginEnd="12dp" />

                <com.wireguard.android.widget.ToggleSwitch
                    android:id="@+id/tunnel_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nextFocusDown="@id/interface_name_text"
                    android:nextFocusForward="@id/interface_name_text"
                    app:checked="@{tunnel.state == State.UP}"
                    app:onBeforeCheckedChanged="@{fragment::setTunnelState}" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- INTERFACE DETAILS CARD -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_section_card_bg"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/interface_details"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_code_brackets"
                        android:contentDescription="@string/interface_details" />

                </LinearLayout>

                <!-- Local Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/local_address"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:visibility="@{config != null &amp;&amp; !config.interface.addresses.isEmpty() ? View.VISIBLE : View.GONE}" />

                <TextView
                    android:id="@+id/interface_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{config.interface.addresses}"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:contentDescription="@string/addresses"
                    android:visibility="@{config != null &amp;&amp; !config.interface.addresses.isEmpty() ? View.VISIBLE : View.GONE}"
                    tools:text="10.0.0.1/24" />

                <!-- ISD-AS Identification (SCION only) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/isd_as_identification"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:visibility="@{config != null &amp;&amp; !config.interface.bootstrapUrl.isEmpty() ? View.VISIBLE : View.GONE}" />

                <TextView
                    android:id="@+id/isd_as_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1-ff00:0:110"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:visibility="@{config != null &amp;&amp; !config.interface.bootstrapUrl.isEmpty() ? View.VISIBLE : View.GONE}"
                    tools:text="1-ff00:0:110" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- NETWORK INFO CARD -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_section_card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/network_info"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Gateway (first peer endpoint or placeholder) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gateway_label"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/gateway_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    tools:text="192.168.1.1" />

                <!-- DNS Servers -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/dns_servers"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:visibility="@{config != null &amp;&amp; !config.interface.dnsServers.isEmpty() ? View.VISIBLE : View.GONE}" />

                <TextView
                    android:id="@+id/dns_servers_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{config.interface.dnsServers}"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:onClick="@{ClipboardUtils::copyTextView}"
                    android:contentDescription="@string/dns_servers"
                    android:visibility="@{config != null &amp;&amp; !config.interface.dnsServers.isEmpty() ? View.VISIBLE : View.GONE}"
                    tools:text="1.1.1.1\n8.8.8.8" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- PATH SELECTION CARD (SCION only) -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/path_selection_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_section_card_bg"
                android:padding="20dp"
                android:layout_marginTop="12dp"
                android:visibility="@{config != null &amp;&amp; !config.interface.bootstrapUrl.isEmpty() ? View.VISIBLE : View.GONE}">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/path_selection"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="16dp" />

                <!-- Path Selection Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/chip_shortest"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="@string/path_shortest"
                        android:textColor="@color/scitra_on_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/scitra_chip_selected"
                        android:onClick="@{fragment::onPathChipClicked}" />

                    <TextView
                        android:id="@+id/chip_most_reliable"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:gravity="center"
                        android:text="@string/path_most_reliable"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp"
                        android:background="@drawable/scitra_chip_unselected"
                        android:onClick="@{fragment::onPathChipClicked}" />

                    <TextView
                        android:id="@+id/chip_longest"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="@string/path_longest"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp"
                        android:background="@drawable/scitra_chip_unselected"
                        android:onClick="@{fragment::onPathChipClicked}" />

                </LinearLayout>

                <!-- Path Visualization (mocked) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <!-- Node: Local -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/scitra_path_node_bg">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="L"
                                android:textColor="@color/scitra_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="LOCAL"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Line connector -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/scitra_path_line"
                        android:layout_marginBottom="18dp" />

                    <!-- Node: Intermediate -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/scitra_path_node_bg">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="I4"
                                android:textColor="@color/scitra_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ISD-1"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Line connector -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/scitra_path_line"
                        android:layout_marginBottom="18dp" />

                    <!-- Node: Destination -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/scitra_path_node_bg">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Z1"
                                android:textColor="@color/scitra_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ZRH-01"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Current Path label -->
                <TextView
                    android:id="@+id/current_path_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CURRENT PATH:  SHORTEST"
                    android:textColor="@color/scitra_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- ACTIVE PEERS SECTION -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/active_peers"
                android:textColor="@color/scitra_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/peers_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@null"
                android:orientation="vertical"
                app:items="@{config.peers}"
                app:layout="@{@layout/tunnel_detail_peer}"
                tools:ignore="UselessLeaf" />

        </LinearLayout>
    </ScrollView>
</layout>
