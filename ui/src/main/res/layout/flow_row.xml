<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="8dp"
    android:background="@drawable/scitra_flow_item_bg"
    android:minHeight="40dp">

    <!-- REMOTE column (weight 0.48) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.48"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status dot -->
            <ImageView
                android:id="@+id/flow_row_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/status_dot"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <!-- Protocol -->
            <TextView
                android:id="@+id/flow_row_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginEnd="4dp"
                tools:text="UDP" />

            <!-- SCION badge -->
            <TextView
                android:id="@+id/flow_row_scion_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flow_scion_badge_label"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="@color/scitra_primary_container"
                android:background="@drawable/scitra_status_badge_bg"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:layout_marginEnd="4dp"
                tools:visibility="visible" />

            <!-- Destination (primary) -->
            <TextView
                android:id="@+id/flow_row_destination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                tools:text="1-ff00:0:111" />

        </LinearLayout>

        <!-- Secondary destination (scionDstIP) -->
        <TextView
            android:id="@+id/flow_row_secondary_dst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:visibility="gone"
            tools:text="192.168.1.1"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- TX column (weight 0.22) -->
    <TextView
        android:id="@+id/flow_row_tx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.22"
        android:textSize="10sp"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        tools:text="1.2 Mbps&#10;500 pps" />

    <!-- RX column (weight 0.22) -->
    <TextView
        android:id="@+id/flow_row_rx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.22"
        android:textSize="10sp"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        tools:text="0.8 Mbps&#10;300 pps" />

    <!-- ACTION column (weight 0.08) -->
    <ImageView
        android:id="@+id/flow_row_chevron"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.08"
        android:src="@drawable/ic_chevron_right"
        android:visibility="invisible"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        tools:visibility="visible" />

</LinearLayout>
