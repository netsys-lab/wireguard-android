<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_dialog_bg"
    android:padding="20dp">

    <!-- Top Bar: Title + Close Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_close_dialog">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/scitra_primary"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mock Backend Simulation"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHOWCASE &amp; TESTING ENVIRONMENT"
                    android:textColor="@color/scitra_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="@color/scitra_on_surface_variant"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:contentDescription="@string/cancel" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Information Card (Highlighted in center) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_section_card_bg"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You are switching to mocked traffic to showcase further functionality of the app."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Network traffic and SCION path metrics are continuously simulated from different autonomous systems and geographic locations around the world. This lets you explore live multi-path switching, 3D interactive globe visualization, latency tracking, and policy failovers without requiring a live SCION network."
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- Mode Selector (Live vs Mock) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Traffic Mode"
                android:textColor="@color/scitra_on_surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <RadioButton
                    android:id="@+id/radio_mock_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟣 Mock Backend"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radio_live_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Live Traffic"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Scenarios Header -->
            <TextView
                android:id="@+id/scenarios_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Simulation Scenario"
                android:textColor="@color/scitra_on_surface"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <!-- Scenario Radio Group -->
            <RadioGroup
                android:id="@+id/scenario_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/scenario_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Standard Multi-Path (Recommended)\nDiverse candidates: Lowest Latency, Highest Bandwidth, Shortest Path."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_globe_showcase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Globe 3D Showcase\nIntercontinental coordinates across Europe, US, and Asia for 3D Globe."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_multi_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Multiple Concurrent Flows\nParallel active SCION flows to test flow list and details switching."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_policy_fallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Policy Fallback Mode\nSimulates policy constraint failure and fallback rule activation."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_high_latency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="High Latency / Congestion\nDegraded paths with 300ms+ latency and high jitter."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pending Path Discovery\nSimulates path lookup latency with loading state and retry."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_stale_override"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stale Override\nActive path override marked as stale/expired to test recovery."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/scenario_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Empty Flows\nZero active flows to test empty list state."
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:paddingVertical="4dp" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/scitra_on_surface_variant" />

        <Button
            android:id="@+id/btn_apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Apply &amp; Switch"
            android:backgroundTint="@color/scitra_primary"
            android:textColor="@color/scitra_on_primary" />
    </LinearLayout>

</LinearLayout>
