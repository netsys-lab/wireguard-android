<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.wireguard.android.model.ObservableTunnel" />
        <variable name="fragment" type="com.wireguard.android.fragment.TunnelListFragment" />
        <variable name="rowConfigurationHandler" type="com.wireguard.android.databinding.ObservableKeyedRecyclerViewAdapter.RowConfigurationHandler" />
        <variable name="tunnels" type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
        <variable name="scionTunnels" type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
        <variable name="standardTunnels" type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scitra_background"
        android:clipChildren="false">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            android:clipToPadding="false"
            android:paddingBottom="88dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Logo centered at the top (larger size) -->
                <FrameLayout
                    android:id="@+id/logo_container"
                    android:layout_width="160dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/logo_scitra"
                        android:scaleType="fitCenter"
                        android:clipToOutline="true" />
                </FrameLayout>

                <!-- Settings button at top right -->
                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/scitra_on_surface_variant"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    app:layout_constraintTop_toTopOf="@id/logo_container"
                    app:layout_constraintBottom_toBottomOf="@id/logo_container"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Tunnels List Container (Bento outline removed) -->
                <LinearLayout
                    android:id="@+id/bento_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/logo_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_max="448dp">

                    <!-- SCION Networks -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCION Tunnels"
                        android:textColor="@color/scitra_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:id="@+id/scion_connect_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/scitra_dashed_item_bg"
                        android:padding="24dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:layout_marginHorizontal="16dp"
                        android:visibility="@{scionTunnels.size() == 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No networks configured"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/scion_tunnel_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="24dp"
                        android:visibility="@{scionTunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                        app:configurationHandler="@{rowConfigurationHandler}"
                        app:items="@{scionTunnels}"
                        app:layout="@{@layout/tunnel_list_item}"
                        tools:itemCount="1"
                        tools:listitem="@layout/tunnel_list_item" />

                    <!-- IP Tunnels -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP Tunnels"
                        android:textColor="@color/scitra_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="16dp" />

                    <!-- Empty State for Standard Tunnels -->
                    <LinearLayout
                        android:id="@+id/standard_tunnels_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/scitra_dashed_item_bg"
                        android:padding="24dp"
                        android:layout_marginHorizontal="16dp"
                        android:visibility="@{standardTunnels.size() == 0 ? android.view.View.VISIBLE : android.view.View.GONE}">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No tunnels configured"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/tunnel_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:visibility="@{standardTunnels.size() > 0 ? android.view.View.VISIBLE : android.view.View.GONE}"
                        app:configurationHandler="@{rowConfigurationHandler}"
                        app:items="@{standardTunnels}"
                        app:layout="@{@layout/tunnel_list_item}"
                        tools:itemCount="2"
                        tools:listitem="@layout/tunnel_list_item" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Fixed bottom container for Add New Tunnel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/scitra_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp"
            android:clipToPadding="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_tunnel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/scitra_btn_primary"
                android:text="Add New Tunnel"
                android:textAllCaps="false"
                android:textColor="@color/scitra_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
