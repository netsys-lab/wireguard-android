<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/scitra_background">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/scitra_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/policy_details_title"
            android:textColor="@color/scitra_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- 1. POLICY OVERVIEW -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/policy_overview_section"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/policy_detail_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Lowest Latency" />

                    <TextView
                        android:id="@+id/policy_detail_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/scitra_status_badge_bg"
                        android:textColor="@color/scitra_on_primary"
                        tools:text="ACTIVE POLICY" />
                </LinearLayout>

                <TextView
                    android:id="@+id/policy_extends_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Extends: default" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/scitra_outline"
                    android:alpha="0.2" />

                <TextView
                    android:id="@+id/policy_summary_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    tools:text="Automatically evaluates all reachable SCION paths and chooses the optimal route by minimizing latency and hop count." />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 2. PRIORITIZATION PIPELINE -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/policy_ordering_section"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paths are ranked and chosen according to this ordered criteria:"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/policy_ordering_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 3. TRAFFIC MATCHER SCOPE -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/policy_traffic_matcher_section"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/protocol_label"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/matcher_protocol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="All protocols" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Source ISD-AS"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/matcher_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Any" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Destination"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/matcher_destination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Any" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Traffic Class"
                        android:textColor="@color/scitra_on_surface_variant"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/matcher_traffic_class"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/scitra_on_surface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Any" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 4. APPLICATION SCOPE -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/policy_app_filter_section"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/app_filter_mode_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/scitra_badge_chip_bg"
                        android:textColor="@color/scitra_primary"
                        tools:text="ALL APPLICATIONS" />
                </LinearLayout>

                <TextView
                    android:id="@+id/app_filter_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="@string/all_apps_scoped" />

                <LinearLayout
                    android:id="@+id/policy_apps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 5. ROUTING CONSTRAINTS & ACL -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/policy_rules_section"
                android:textColor="@color/scitra_on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Performance Requirements"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Requirements 3-box row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/scitra_section_card_bg"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Min MTU"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/req_min_mtu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/scitra_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="1420 B" />
                    </LinearLayout>

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/scitra_section_card_bg"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Max Latency"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/req_max_latency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/scitra_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="50 ms" />
                    </LinearLayout>

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/scitra_section_card_bg"
                        android:padding="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Min Bandwidth"
                            android:textColor="@color/scitra_on_surface_variant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/req_min_bw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/scitra_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="100 Mbps" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/scitra_outline"
                    android:alpha="0.2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access Control List (ACL)"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/policy_acl_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 6. RAW POLICY SPECIFICATION (JSON) -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/policy_json_spec_section"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/btn_copy_json"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy_json"
                    android:textColor="@color/scitra_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/scitra_card_bg"
                android:padding="12dp"
                android:layout_marginBottom="24dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="horizontal">

                    <TextView
                        android:id="@+id/tv_policy_json"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="@color/scitra_on_surface"
                        android:lineSpacingExtra="2dp"
                        tools:text="{\n  &quot;policies&quot;: {\n    &quot;default&quot;: {}\n  }\n}" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- 7. ACTIONS -->
            <!-- ═══════════════════════════════════════ -->
            <TextView
                android:id="@+id/btn_configure_policy_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="@string/edit_path_policy"
                android:textColor="@color/scitra_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/scitra_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp" />

            <TextView
                android:id="@+id/btn_reset_policy_action"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/reset_to_default_policy"
                android:textColor="@color/scitra_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
