<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scitra_card_bg"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hop_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/scitra_on_surface_variant"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            tools:text="01" />

        <TextView
            android:id="@+id/hop_isa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/scitra_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1-ff00:0:110" />

        <TextView
            android:id="@+id/hop_role_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            tools:text="Direct" />
    </LinearLayout>

    <!-- Grid content -->
    <LinearLayout
        android:id="@+id/hop_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

    <!-- Note -->
    <TextView
        android:id="@+id/hop_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/scitra_on_surface_variant"
        android:textSize="10sp"
        android:alpha="0.7"
        android:visibility="gone" />
</LinearLayout>