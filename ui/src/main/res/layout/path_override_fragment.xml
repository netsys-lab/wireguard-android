<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/scitra_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/override_path_title"
                android:textColor="@color/scitra_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/override_path_subtitle"
            android:textColor="@color/scitra_on_surface_variant"
            android:textSize="13sp" />

        <!-- Context card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/scitra_card_bg"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/destination"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/ob_context_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:textAlignment="textEnd"
                    tools:text="1-ff00:0:111 · 10.0.0.5:443" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/automatic_policy"
                    android:textColor="@color/scitra_on_surface_variant"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/ob_context_policy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/scitra_on_surface"
                    android:textSize="12sp"
                    android:textAlignment="textEnd"
                    tools:text="Lowest Latency" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick selection header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/quick_selection"
            android:textColor="@color/scitra_on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Candidate paths container (populated programmatically) -->
        <LinearLayout
            android:id="@+id/ob_candidates_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!-- View all paths -->
        <TextView
            android:id="@+id/btn_view_all_paths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/scitra_primary_container"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingVertical="12dp"
            android:visibility="gone"
            tools:text="View all 6 paths →"
            tools:visibility="visible" />

        <!-- Actions -->
        <TextView
            android:id="@+id/btn_use_selected_path"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/use_selected_path"
            android:textColor="@color/scitra_on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/scitra_edit_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false" />

        <TextView
            android:id="@+id/btn_cancel_override"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/scitra_on_surface_variant"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingVertical="12dp" />
    </LinearLayout>
</ScrollView>