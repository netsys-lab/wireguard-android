<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected / Activated state (multi-selected or single-selected) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/scitra_primary_fixed" />
            <stroke
                android:width="2dp"
                android:color="@color/scitra_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Default / Unselected state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scitra_surface_container_high" />
            <stroke
                android:width="1dp"
                android:color="@color/scitra_outline_variant" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>

