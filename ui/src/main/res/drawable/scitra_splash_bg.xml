<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen window background: dark bg with centered app logo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background fill -->
    <item>
        <color android:color="@color/scitra_background" />
    </item>
    <!-- Centered logo -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <bitmap
            android:src="@drawable/logo_scitra"
            android:gravity="fill" />
    </item>
</layer-list>
