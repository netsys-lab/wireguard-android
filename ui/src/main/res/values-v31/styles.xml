<resources>
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/scitra_splash_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/scitra_background</item>
        <item name="android:navigationBarColor">@color/scitra_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Android 12+ System Splash Screen Attributes -->
        <item name="android:windowSplashScreenBackground">@color/scitra_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_scitra</item>
    </style>
</resources>
